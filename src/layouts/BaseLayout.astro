---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n } from '../i18n/ui';
import { ogLocale, siteConfig } from '../config';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.zh;
const { messages } = getI18n(Astro.url);
const attractionName = messages.header?.siteName ?? messages.footer?.siteName ?? messages.meta.title;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: attractionName,
  description: messages.meta.description,
  url: canonical,
  image: 'https://giantkhanstatue.com/gallery/chinggis-khaan-statue-complex-1.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ulaanbaatar Chinggis Khaan Statue, ND - 5 khoroo, Nalaikh',
    addressLocality: 'Ulaanbaatar',
    addressRegion: 'Ulaanbaatar',
    postalCode: '12593',
    addressCountry: 'MN',
  },
  telephone: '+97670120202',
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 47.8079,
    longitude: 107.5369,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '10:00',
      closes: '18:00',
    },
  ],
  isAccessibleForFree: false,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '4344',
  },
  sameAs: ['https://maps.app.goo.gl/iNBHqntxJc3M3wwp9'],
};
  const breadcrumbLd = (() => {
    const bc = messages.breadcrumb;
    return {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: bc.home, item: `${siteConfig.baseUrl}/${lang}` },
        { '@type': 'ListItem', position: 2, name: bc.region, item: `${siteConfig.baseUrl}/${lang}#overview` },
        { '@type': 'ListItem', position: 3, name: bc.city, item: `${siteConfig.baseUrl}/${lang}#transport` },
        { '@type': 'ListItem', position: 4, name: bc.current, item: canonical },
      ],
    };
  })();

  const parkLd = {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': 'https://giantkhanstatue.com/#attraction',
    name: attractionName,
    alternateName: ['Чингис Хааны морин хөшөө', 'Цонжин Болдог', 'Chinggis Khaan Statue Complex', '成吉思汗骑马雕像', 'チンギス・カン騎馬像', '칭기즈 칸 기마상'],
    description: messages.meta.description,
    url: canonical,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Ulaanbaatar Chinggis Khaan Statue, ND - 5 khoroo, Nalaikh',
      addressLocality: 'Ulaanbaatar',
      addressRegion: 'Ulaanbaatar',
      postalCode: '12593',
      addressCountry: 'MN',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 47.8079,
      longitude: 107.5369,
    },
    isAccessibleForFree: false,
    publicAccess: true,
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '10:00',
      closes: '18:00',
    },
    sameAs: ['https://maps.app.goo.gl/iNBHqntxJc3M3wwp9'],
  };
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh" href={alts.zh} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="ja" href={alts.ja} />
    <link rel="alternate" hreflang="ko" href={alts.ko} />
    <link rel="alternate" hreflang="mn" href={alts.mn} />
    <link rel="alternate" hreflang="ru" href={alts.ru} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    <meta property="og:image" content="https://giantkhanstatue.com/gallery/chinggis-khaan-statue-complex-1.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://giantkhanstatue.com/gallery/chinggis-khaan-statue-complex-1.jpg" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>

    <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXX" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(parkLd)}></script>

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <NoticeBanner />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var code = btn.getAttribute('data-copy') || '';
            if (!code) return;
            var prev = btn.getAttribute('data-label') || btn.textContent;
            btn.setAttribute('data-label', prev);
            var done = function () {
              btn.textContent = '✓';
              setTimeout(function () { btn.textContent = prev; }, 1500);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(code).then(done).catch(function () {});
            } else {
              var ta = document.createElement('textarea');
              ta.value = code; document.body.appendChild(ta); ta.select();
              try { document.execCommand('copy'); done(); } catch (err) {}
              document.body.removeChild(ta);
            }
          });
        });
      })();
    </script>
  </body>
</html>
