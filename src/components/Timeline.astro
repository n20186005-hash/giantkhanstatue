---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const t = messages.timeline;
const items = t.items ?? [];
---

<section id="timeline" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{t.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{t.subtitle}</p>
    </div>

    <ol class="timeline-list">
      {items.map((it) => (
        <li class="timeline-item">
          <div class="timeline-marker" aria-hidden="true">
            <span class="timeline-icon">{it.icon}</span>
          </div>
          <div class="timeline-card">
            <span class="timeline-year">{it.year}</span>
            <h3 class="timeline-card-title">{it.title}</h3>
            <p class="timeline-card-desc">{it.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .timeline-list::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .timeline-item {
    position: relative;
    padding-left: 4.5rem;
    padding-bottom: 2rem;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-bg);
    border: 2px solid var(--accent);
    box-shadow: var(--card-shadow);
    z-index: 1;
  }
  .timeline-icon {
    font-size: 1.5rem;
    line-height: 1;
  }
  .timeline-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 18px;
    padding: 1.25rem 1.5rem;
    box-shadow: var(--card-shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .timeline-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.1);
  }
  .timeline-year {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .timeline-card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--text-primary);
  }
  .timeline-card-desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  @media (min-width: 768px) {
    .timeline-list::before {
      left: 35px;
    }
    .timeline-item {
      padding-left: 5.5rem;
    }
    .timeline-marker {
      width: 72px;
      height: 72px;
    }
    .timeline-icon {
      font-size: 1.9rem;
    }
  }
</style>
